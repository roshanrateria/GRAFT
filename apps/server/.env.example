# GRAFT Server Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Doctor Provider Configuration
# ===========================================

# Doctor provider: crew | llm | replay
DOCTOR_PROVIDER=replay

# LLM configuration (for 'llm' provider)
# Any OpenAI-compatible chat completions endpoint works. Two examples:
# NVIDIA Integrate API: create an API key at https://build.nvidia.com
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
DOCTOR_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Google Gemini (OpenAI-compatible): create an API key at https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-google-api-key
# DOCTOR_MODEL=gemini-3.5-flash-lite

# ===========================================
# Live Mode Configuration
# ===========================================

# Passcode for live Doctor mode (demo judges)
# Set this to a secure passcode and share only via Devpost judge-only field
LIVE_PASSCODE=your-secure-passcode-here

# ===========================================
# Server Configuration
# ===========================================

# Server port (default: 3001)
PORT=3001

# Server host (default: localhost)
HOST=localhost

# CORS origin for frontend (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
