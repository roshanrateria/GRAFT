# GRAFT Server Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Doctor Provider Configuration
# ===========================================

# Doctor provider: crew | llm | replay
DOCTOR_PROVIDER=replay

# LLM configuration (for 'llm' provider)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
DOCTOR_MODEL=gpt-4o

# ===========================================
# Live Mode Configuration
# ===========================================

# Passcode for live Doctor mode (demo judges)
# Set this to a secure passcode and share only via Devpost judge-only field
LIVE_PASSCODE=your-secure-passcode-here

# ===========================================
# Server Configuration
# ===========================================

# Server port (default: 3001)
PORT=3001

# Server host (default: localhost)
HOST=localhost

# CORS origin for frontend (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
